<!DOCTYPE html>

<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<title>Program Record Entry</title>
	<link rel="stylesheet" href="../styles/dashboard.css" />
	<link rel="stylesheet" href="../styles/tableDesign.css" />
	<link rel="stylesheet" href="../styles/header.css" />
	<link rel="stylesheet" href="../styles/footer.css" />
	<script>
		function setExamValue(exam) {
			document.getElementById("exam").value = exam;
		}
		setTimeout(() => {
			const warning = document.getElementById("warning");
			if (warning) {
				warning.style.opacity = "50%"; // fade out
				setTimeout(() => {
					warning.style.display = "none"; // remove from layout after fade
				}, 500); // match fade duration
			}
		}, 4000);
	</script>
</head>

<body>
	<%- include('./partials/header.ejs')%>

		<div class="entry">
			<div class="entry1">
				<!-- code for archive record -->
				<% if (locals.warning) { %>
					<div id="warning" class="warning-message">
						<%=warning%>
					</div>
					<% } %>
						<%- include('./partials/archive.ejs')%>

							<!-- Code for Inter and BS record  -->

							<% psfData.forEach((row, index)=> { %>
								<%if(row.psf_status==1 && row.duration==2){%>
									<div class="search psf<%=row.duration%>">
										<div class="search1">
											<form action="" method="post">
												<div class="attendance">
													<label class="heading">Attendance</label>
													<hr />
													<button formaction="/attendance/" name="a_list"
														value="Click" class="bt1 gap">
														Today\'s Attendance : <%=date%><br />
															<%=row.program_name.toUpperCase()%> <br />
																<%= row.class_name%><br />
																	<%= row.subject_name%>
													</button>

													<select class="selectdate gap" name="month" id="monthDropdown">
														<% if (row.months) { row.months.split(",").forEach(m=> {
															let year = m.substring(0,4);
															let month = m.substring(5,7);
															const monthNames= [ "Jan","Feb","Mar","April","May","June",
															"July","Aug","Sept","Oct","Nov","Dec" ];
															let monthName = monthNames[parseInt(month)-1]; %>

															<option value="<%= year %>-<%= month %>-01">
																<%= monthName %> - <%= year %>
															</option>

															<% }) } else { %>
																<option value="">No Records</option>
																<% } %>
													</select>
													<button formaction="/monthlyAttendance" name="all_list" value=""
														class="bt3 gap" type="submit">
														Monthly Attendence List
													</button>
													<div class="flexRow">
													<button formaction="/markPreviousAttendance" name="inprevious"
														value="" class="bt1 gap" type="submit">
														Mark Previous Attendance
													</button>
													<button formaction="/updateAttendance" name="markleave" value=""
														class="bt1 gap" type="submit">
														Update Attendance
													</button>
														
													</div>
												</div>
												<div class="exam">
													<label class="heading">EXAM</label>
													<hr />

													<div class="flexRow">
														<button name="marking" formaction="/examMarksEntry"
															class="bt1 gap" type="submit">
															Marking
														</button>

														<button name="result" formaction="/displayExamMarks"
															class="bt1 gap" type="submit">
															View Result
														</button>


														<button name="result_update" formaction="/updateExamMarks" class="bt1 gap" type="submit">
															Update
														</button>

													</div>
												</div>
												<input type="hidden" name="pid" value="<%= row.program_id %>" />
												<input type="hidden" name="psfid" value="<%= row.psf_id %>" />
											</form>
										</div>
									</div>
									<%}%>




										<%if(row.psf_status==1 && row.duration==4){%>
											<div class="search psf<%=row.duration%>">
												<div class="search1">
													<form action="" method="post">
														<div class="attendance">
															<label class="heading">Attendance</label>
															<hr />
															<button name="course_file" value="" class="bt11 gap"
																type="submit">
																Print Course File
															</button>
															<button formaction="/attendance/currentAttendance"
																name="a_list" value="Click" class="bt11 gap">
																Today\'s Attendance : <%=date%><br />
																	<%=row.program_name.toUpperCase()%><br />
																		<%= row.class_name%><br />
																			<%= row.subject_name%>
															</button>

															<select class="selectdate gap" name="month"
																id="monthDropdown">
																<% if (row.months) { row.months.split(",").forEach(m=> {
																	let year = m.substring(0,4);
																	let month = m.substring(5,7);
																	const monthNames = [
																	"Jan","Feb","Mar","April","May","June",
																	"July","Aug","Sept","Oct","Nov","Dec" ];
																	let monthName = monthNames[parseInt(month)-1]; %>

																	<option value="<%= year %>-<%= month %>-01">
																		<%= monthName %> - <%= year %>
																	</option>

																	<% }) } else { %>
																		<option value="">No Records</option>
																		<% } %>
															</select>
															<button formaction="/monthlyAttendance" name="all_list"
																value="" class="bt3 gap" type="submit">
																Monthly Attendence List
															</button>
															<div class="flexRow">
																<button formaction="/markPreviousAttendance"
																name="inprevious" value="" class="bt11 gap"
																type="submit">
																Mark Previous Attendance
															</button>
															<button formaction="update_attendance" name="markleave"
																value="" class="bt11 gap" type="submit">
																Update Attendance
															</button>
															</div>
															
														</div>
														<div class="exam">
															<label class="heading">EXAM</label>
															<hr />

															<div class="flexRow">
																<button name="marking" formaction="/examMarksEntry"
																	class="bt11 gap" type="submit">
																	Marking
																</button>

																<button name="result"
																	formaction="/displayExamMarks" class="bt11 gap"
																	type="submit">
																	View Result
																</button>


																<button name="result_update" formaction="/updateExamMarks" class="bt11 gap"
																	type="submit">
																	Update
																</button>

															</div>
														</div>
														<div class="topics">
															<label class="heading">Course File Topics</label>
															<hr />
															<div class="flexRow">
															<button name="topics" value="" class="bt11" type="submit"
																onclick="setExamValue(\'PRESENTATION\')"
																style="margin-right: 10px">
																Presentation
															</button>
															<button name="topics" value="" class="bt11" type="submit"
																onclick="setExamValue(\'QUIZ\')"
																style="margin-right: 10px">
																Quiz
															</button>
															<button name="topics" value="" class="bt11" type="submit"
																onclick="setExamValue(\'ASSIGNMENT\')"
																style="margin-right: 10px">
																Assignment
															</button>
															<button name="Weekly_Topics" value="" class="bt11"
																type="submit" onclick="setExamValue(\'Weekly_Topics\')"
																style="margin-right: 10px">
																Weekly_Topics
															</button>
															
															</div>
														</div>
														<input type="hidden" name="pid" value="<%= row.program_id %>" />
														<input type="hidden" name="psfid" value="<%= row.psf_id %>" />
													</form>
												</div>
											</div>
											<%}%>
												<%})%>
			</div>
		</div>

		<%- include('./partials/footer.ejs')%>
			<script src="../scripts/dashboardScript.js">
			</script>

</body>

</html>